# Enterprise AI Document Assistant - local development settings
#
# Copy this file to .env when you need to customize host ports, local
# PostgreSQL credentials, document-processing boundaries, optional malware
# scanning, audit retention, observability export, or answer generation.
#
# Do not reuse these values for a public or production deployment.

# Host ports
WEB_UI_HOST_PORT=3000
API_HOST_PORT=5000
AI_SERVICE_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# Optional observability-stack host ports. These services start only when
# docker-compose.observability.yml is included explicitly and are bound to
# 127.0.0.1 by default rather than exposed on all host interfaces.
OTEL_COLLECTOR_HOST_PORT=4318
OTEL_COLLECTOR_HEALTH_HOST_PORT=13133
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001
ALERTMANAGER_HOST_PORT=9093
GRAFANA_ADMIN_PASSWORD=admin-local

# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Development
SERVICE_VERSION=dev

# PostgreSQL local development administrator
POSTGRES_DB=documents
POSTGRES_USER=documents
POSTGRES_PASSWORD=documents

# Separate application trust boundaries created by the tenant lifecycle migrations.
# document_app: tenant-scoped public API reads/writes.
# document_platform: lifecycle management and cross-tenant read/audit access only.
# document_privileged: background-worker processing writes; never supplied to document-api.
APP_DB_PASSWORD=document-app-local
PLATFORM_DB_PASSWORD=document-platform-local
PRIVILEGED_DB_PASSWORD=document-privileged-local

# Safe document-processing boundaries used by upload inspection and the worker.
DOCUMENT_MAX_PDF_PAGES=200
DOCUMENT_MAX_DOCX_ARCHIVE_ENTRIES=2048
DOCUMENT_MAX_DOCX_EXPANDED_BYTES=52428800
DOCUMENT_MAX_EXTRACTED_CHARACTERS=1000000
DOCUMENT_MAX_DOCX_XML_CHARACTERS=5000000

# Malware scanning is explicitly disabled in the credential/service-free local default.
# Set FILE_THREAT_SCANNING_PROVIDER=ClamAv only when a trusted clamd endpoint is available.
# When enabled, scanner timeout/unavailability fails closed and rejects the upload.
FILE_THREAT_SCANNING_PROVIDER=Disabled
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=00:00:10
CLAMAV_CHUNK_SIZE_BYTES=65536

# Audit retention archives old rows into a tenant-RLS protected archive table.
# It is disabled by default. Only the privileged worker can call the bounded archive function.
AUDIT_RETENTION_ENABLED=false
AUDIT_RETENTION_DAYS=90
AUDIT_RETENTION_BATCH_SIZE=1000
AUDIT_RETENTION_MAX_BATCHES=10
AUDIT_RETENTION_INTERVAL=1.00:00:00
AUDIT_RETENTION_INITIAL_DELAY=00:01:00

# Optional OTLP/HTTP base endpoint. Leave blank to run without a collector.
# When using the observability Compose override this value is replaced inside containers.
# Example for a host collector: http://host.docker.internal:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Grounded-answer generation. Deterministic is the safe credential-free default.
# Set ANSWER_GENERATION_PROVIDER=OpenAiCompatible only after supplying all three
# external-provider values through a trusted secret/configuration mechanism.
ANSWER_GENERATION_PROVIDER=Deterministic
ANSWER_MINIMUM_SOURCE_SCORE=0.20
ANSWER_MAX_SOURCES=5
ANSWER_MAX_CONTEXT_CHARACTERS=12000
ANSWER_REJECT_NEAR_TIE_EVIDENCE=true
ANSWER_CONFLICT_SCORE_DELTA=0.000001
ANSWER_PROVIDER_ENDPOINT=
ANSWER_PROVIDER_API_KEY=
ANSWER_PROVIDER_MODEL=
ANSWER_PROVIDER_TIMEOUT_SECONDS=20
ANSWER_PROVIDER_MAX_OUTPUT_TOKENS=500
